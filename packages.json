{
  "$schema": "./packages.schema.json",
  "packages": {
    "@agegr/pi-web": {
      "version": "latest",
      "type": "tool",
      "description": "Pi Web UI - 浏览器界面启动 Pi",
      "extensions": [
        "pi-web"
      ],
      "installTarget": "npm-global",
      "homepage": "https://www.npmjs.com/package/@agegr/pi-web"
    },
    "pi-edit-hooks": {
      "version": "latest",
      "type": "extension",
      "description": "编辑钩子 - 文件编辑后自动执行脚本",
      "extensions": [
        "pi-edit-hooks"
      ],
      "extensionPaths": [
        "node_modules/pi-edit-hooks/src/index.ts"
      ],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/pi-edit-hooks"
    },
    "pi-hashline-edit-pro": {
      "version": "latest",
      "type": "extension",
      "description": "Hashline 编辑 Pro - 基于内容哈希(3 字符锚点)的精确编辑",
      "extensions": [
        "pi-hashline-edit-pro"
      ],
      "extensionPaths": [
        "node_modules/pi-hashline-edit-pro/index.ts"
      ],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/pi-hashline-edit-pro"
    },
    "pi-mcp-adapter": {
      "version": "latest",
      "type": "extension",
      "description": "MCP 适配器 - 连接 MCP 服务器",
      "extensions": [
        "pi-mcp-adapter"
      ],
      "extensionPaths": [
        "node_modules/pi-mcp-adapter/index.ts"
      ],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/pi-mcp-adapter"
    },
    "pi-web-access": {
      "version": "latest",
      "type": "extension",
      "description": "Web 访问 - 搜索和网页内容获取",
      "extensions": [
        "pi-web-access"
      ],
      "extensionPaths": [
        "node_modules/pi-web-access/index.ts"
      ],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/pi-web-access"
    },
    "pi-feishu-lark": {
      "version": "latest",
      "type": "extension",
      "category": "bridge",
      "description": "飞书/Lark 桥接 - 手机对话 Pi（长连接，无流式、无 cron）",
      "extensions": [
        "pi-feishu-lark"
      ],
      "extensionPaths": [
        "node_modules/pi-feishu-lark/.pi/extensions/feishu/index.ts"
      ],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/pi-feishu-lark"
    },
    "pi-shiki-subagents": {
      "version": "refactor/mode-first-stabilization",
      "type": "extension",
      "description": "Pi-shiki-subagents Pi adapter - 轻量多 agent 协调层（git 源码仓库）",
      "extensions": [
        "pi-shiki-subagents"
      ],
      "installTarget": "bundle",
      "repoUrl": "https://github.com/RoyougiShiki/Pi-shiki-subagents.git",
      "branch": "refactor/mode-first-stabilization",
      "extensionPaths": [
        "node_modules/pi-shiki-subagents/src/pi/core/pi-shiki-subagents.ts"
      ],
      "homepage": "https://github.com/RoyougiShiki/Pi-shiki-subagents",
      "gitUrl": "github:RoyougiShiki/Pi-shiki-subagents#refactor/mode-first-stabilization",
      "bundleDir": ".pi/bundle-pi-shiki"
    },
    "pi-shiki-todo": {
      "version": "master",
      "type": "extension",
      "description": "Pi-shiki-todo 任务管理(rpiv-todo fork,独立单包)",
      "extensions": [
        "pi-shiki-todo"
      ],
      "installTarget": "bundle",
      "gitUrl": "github:RoyougiShiki/Pi-shiki-todo#master",
      "repoUrl": "https://github.com/RoyougiShiki/Pi-shiki-todo.git",
      "branch": "master",
      "extensionPaths": [
        "node_modules/pi-shiki-todo/index.ts"
      ],
      "homepage": "https://github.com/RoyougiShiki/Pi-shiki-todo",
      "bundleDir": ".pi/bundle-pi-shiki"
    },
    "pi-vision-handoff": {
      "version": "latest",
      "type": "extension",
      "category": "vision",
      "description": "视觉桥接 - 纯文本模型读图（自动替换为视觉模型描述，支持 fallback）",
      "extensions": [
        "pi-vision-handoff"
      ],
      "extensionPaths": [
        "node_modules/pi-vision-handoff/vision-handoff.ts"
      ],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/pi-vision-handoff"
    }
  }
}