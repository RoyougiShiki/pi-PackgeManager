{
  "$schema": "./packages.schema.json",
  "packages": {
    "@agegr/pi-web": {
      "version": "latest",
      "type": "tool",
      "description": "Pi Web UI - 浏览器界面启动 Pi",
      "extensions": ["pi-web"],
      "installTarget": "npm-global",
      "homepage": "https://www.npmjs.com/package/@agegr/pi-web"
    },
    "oh-my-opencode-slim": {
      "version": "refactor/mode-first-stabilization",
      "type": "extension",
      "description": "OMO slim Pi adapter - 轻量多 agent 协调层（git 源码仓库）",
      "extensions": ["oh-my-opencode-slim"],
      "installTarget": "git",
      "repoUrl": "https://github.com/RoyougiShiki/oh-my-opencode-slim.git",
      "branch": "refactor/mode-first-stabilization",
      "extensionPaths": ["src/pi/core/pi.ts"],
      "homepage": "https://github.com/RoyougiShiki/oh-my-opencode-slim"
    },
    "@juicesharp/rpiv-ask-user-question": {
      "version": "latest",
      "type": "extension",
      "description": "问用户问题 - 结构化问答界面",
      "extensions": ["rpiv-ask-user-question"],
      "extensionPaths": ["node_modules/@juicesharp/rpiv-ask-user-question/index.ts"],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/@juicesharp/rpiv-ask-user-question"
    },
    "@juicesharp/rpiv-todo": {
      "version": "latest",
      "type": "extension",
      "description": "任务管理 - 多步骤任务追踪",
      "extensions": ["rpiv-todo"],
      "extensionPaths": ["node_modules/@juicesharp/rpiv-todo/index.ts"],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/@juicesharp/rpiv-todo"
    },
    "@narumitw/pi-goal": {
      "version": "latest",
      "type": "extension",
      "description": "目标管理 - 目标追踪和完成验证",
      "extensions": ["pi-goal"],
      "extensionPaths": ["node_modules/@narumitw/pi-goal/src/index.ts"],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/@narumitw/pi-goal"
    },
    "pi-edit-hooks": {
      "version": "latest",
      "type": "extension",
      "description": "编辑钩子 - 文件编辑后自动执行脚本",
      "extensions": ["pi-edit-hooks"],
      "extensionPaths": ["node_modules/pi-edit-hooks/src/index.ts"],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/pi-edit-hooks"
    },
    "pi-hashline-edit": {
      "version": "github:georgebashi/pi-hashline-edit",
      "type": "extension",
      "description": "Hashline 编辑 - 基于 LINE#ID 的精确编辑",
      "extensions": ["pi-hashline-edit"],
      "extensionPaths": ["node_modules/pi-hashline-edit/index.ts"],
      "installTarget": "bundle",
      "homepage": "https://github.com/georgebashi/pi-hashline-edit"
    },
    "pi-mcp-adapter": {
      "version": "latest",
      "type": "extension",
      "description": "MCP 适配器 - 连接 MCP 服务器",
      "extensions": ["pi-mcp-adapter"],
      "extensionPaths": ["node_modules/pi-mcp-adapter/index.ts"],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/pi-mcp-adapter"
    },
    "pi-web-access": {
      "version": "latest",
      "type": "extension",
      "description": "Web 访问 - 搜索和网页内容获取",
      "extensions": ["pi-web-access"],
      "extensionPaths": ["node_modules/pi-web-access/index.ts"],
      "installTarget": "bundle",
      "homepage": "https://www.npmjs.com/package/pi-web-access"
    }
  }
}
