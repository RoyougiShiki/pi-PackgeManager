#!/usr/bin/env bash
# pi-browser-link —— 一键拉起 WSL→Windows 浏览器 CDP 转发链路
# 用法: pi-browser-link [status|up|down]
# 自动发现 Edge / Chrome 的 autoConnect 调试端口（读 DevToolsActivePort）
# 依赖: socat (WSL) + Windows 侧 node (C:\Program Files\nodejs\node.exe)

set -euo pipefail
ACTION="${1:-status}"

WSL_FORWARD_JS="/mnt/c/Users/h/AppData/Local/Temp/forward-gen.js"
GATEWAY=$(ip route | awk '/default/{print $3; exit}')
NODE_WIN='C:\Program Files\nodejs\node.exe'

mkdir -p "$HOME/.pi-browser-link"

# 参数化 Windows 转发器（监听 0.0.0.0:<port> → 127.0.0.1:<port>）
if [ ! -f "$WSL_FORWARD_JS" ]; then
  cat > "$WSL_FORWARD_JS" <<'EOF'
const net = require('net');
const PORT = Number(process.argv[2]);
net.createServer((c) => {
  const up = net.connect(PORT, '127.0.0.1');
  up.on('connect', () => { c.pipe(up); up.pipe(c); });
  up.on('error', () => c.destroy());
  c.on('error', () => up.destroy());
}).listen(PORT, '0.0.0.0', () => console.log('forwarder ' + PORT));
EOF
fi

find_port() { # $1=浏览器 user-data-dir(Windows 路径) → 输出端口
  local f="/mnt/c/Users/h/AppData/Local/$1/User Data/DevToolsActivePort"
  [ -f "$f" ] && head -1 "$f" | tr -d '\r' || echo ""
}

status() {
  echo "=== 浏览器调试端口 ==="
  local ep cp
  ep=$(find_port "Microsoft/Edge"); cp=$(find_port "Google/Chrome")
  echo "Edge  : ${ep:-无}"
  echo "Chrome: ${cp:-无}"
  echo "=== WSL socat ==="
  pgrep -af "socat TCP-LISTEN" | grep -v pgrep || echo "未运行"
  echo "=== Windows 转发器 ==="
  powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name='node.exe'\" | Where-Object { \$_.CommandLine -match 'forward-gen' } | Select-Object ProcessId | Format-Table -HideTableHeaders" 2>/dev/null | tr -d '\r'
  echo "=== 端到端（autoConnect 模式 404 属正常）==="
  local ep cp
  ep=$(find_port "Microsoft/Edge"); cp=$(find_port "Google/Chrome")
  for port in $ep $cp; do
    [ -n "$port" ] || continue
    local code
    code=$(timeout 2 curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/json/version" 2>/dev/null)
    case "$code" in
      200) echo ":$port ✅ 标准 CDP 就绪" ;;
      404) echo ":$port ✅ autoConnect 模式（HTTP 404 正常，用 DevToolsActivePort 的 WS 连接）" ;;
      *) echo ":$port ❌ 未通（浏览器未运行或 Allow 未开）" ;;
    esac
  done
}

up_one() { # $1=port
  local port="$1"
  # Windows 侧转发器（0.0.0.0:port → 127.0.0.1:port）
  powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name='node.exe'\" | Where-Object { \$_.CommandLine -match 'forward-gen' -and \$_.CommandLine -match ' $port' } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force }" 2>/dev/null || true
  powershell.exe -NoProfile -Command "Start-Process '$NODE_WIN' -ArgumentList 'C:\Users\h\AppData\Local\Temp\forward-gen.js','$port' -WindowStyle Hidden" 2>/dev/null || true
  # WSL 侧 socat
  pkill -f "socat TCP-LISTEN:$port" 2>/dev/null || true
  sleep 1
  nohup socat "TCP-LISTEN:$port,fork,reuseaddr" "TCP:$GATEWAY:$port" > "/tmp/socat-$port.log" 2>&1 &
  sleep 1
  echo ":$port 链路已拉起"
}

up() {
  local ep cp
  ep=$(find_port "Microsoft/Edge"); cp=$(find_port "Google/Chrome")
  [ -n "$ep" ] && up_one "$ep"
  [ -n "$cp" ] && up_one "$cp"
  echo "=== 验证 ==="
  status "$ep" "$cp"
}

down() {
  pkill -f "socat TCP-LISTEN" 2>/dev/null || true
  powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name='node.exe'\" | Where-Object { \$_.CommandLine -match 'forward-gen' } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force }" 2>/dev/null || true
  echo "链路已停止"
}

case "$ACTION" in
  status) status ;;
  up) up ;;
  down) down ;;
  *) echo "用法: $0 [status|up|down]"; exit 1 ;;
esac
