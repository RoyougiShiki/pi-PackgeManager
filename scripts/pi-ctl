#!/usr/bin/env bash
# pi-ctl - Pi 包管理器
# 管理 pi-web 和 bundle 扩展
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
PACKAGES_FILE="$REPO_DIR/packages.json"
BUNDLE_DIR="$HOME/.pi/bundle"
GIT_DIR="$HOME/.pi/packages"

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Node.js JSON 解析（使用 fs.readFileSync）
json_get() {
  local file="$1"
  local expr="$2"
  node -e "const fs=require('fs');const data=JSON.parse(fs.readFileSync('$file','utf8'));$expr" 2>/dev/null || echo ""
}

json_keys() {
  local file="$1"
  node -e "const fs=require('fs');const data=JSON.parse(fs.readFileSync('$file','utf8'));console.log(Object.keys(data.packages).join('\\n'));" 2>/dev/null
}

usage() {
  cat << EOF
Pi 包管理器

用法: pi-ctl <命令> [参数]

命令:
  status              显示所有包的版本状态
  update              更新所有包
  update <包名>       更新指定包
  install             安装所有配置的包
  add <包名> [版本]   添加包到配置
  remove <包名>       从配置移除包
  list                列出所有配置的包

环境变量:
  PI_CTL_SKIP_UPDATE_CHECK=1   跳过版本检查
EOF
}

# 获取 npm 最新版本
get_latest_version() {
  local pkg="$1"
  npm info "$pkg" version 2>/dev/null || echo "unknown"
}

# 获取已安装版本
get_installed_version() {
  local pkg="$1"
  local target="$2"

  if [[ "$target" == "npm-global" ]]; then
    npm list -g "$pkg" --depth=0 2>/dev/null | grep -E "^└──|^├──" | sed 's/.*@//' | head -1 || echo "not installed"
  elif [[ "$target" == "git" ]]; then
    if [[ -d "$GIT_DIR/$pkg/.git" ]]; then
      git -C "$GIT_DIR/$pkg" rev-parse --short HEAD 2>/dev/null || echo "not installed"
    else
      echo "not installed"
    fi
  else
    if [[ -f "$BUNDLE_DIR/package.json" ]]; then
      (cd "$BUNDLE_DIR" && npm list "$pkg" --depth=0 2>/dev/null | grep -E "^└──|^├──" | sed 's/.*@//' | head -1) || echo "not installed"
    else
      echo "not installed"
    fi
  fi
}

# git 包: 最新版本 = 远程分支 HEAD
get_git_latest() {
  local pkg="$1"
  local repo_url branch
  repo_url=$(json_get "$PACKAGES_FILE" "console.log(data.packages['$pkg']?.repoUrl||'')")
  branch=$(json_get "$PACKAGES_FILE" "console.log(data.packages['$pkg']?.branch||'')")
  if [[ -z "$repo_url" ]]; then echo "unknown"; return; fi
  if [[ -n "$branch" ]]; then
    git ls-remote --heads "$repo_url" "$branch" 2>/dev/null | head -1 | cut -c1-7 || echo "unknown"
  else
    git ls-remote --symref "$repo_url" HEAD 2>/dev/null | grep 'ref: refs/heads' | awk '{print $2}' | sed 's|refs/heads/||' || echo "unknown"
  fi
}

# git 包: 安装/更新 (clone 或 pull + checkout 指定分支)
git_sync() {
  local pkg="$1"
  local repo_url branch
  repo_url=$(json_get "$PACKAGES_FILE" "console.log(data.packages['$pkg']?.repoUrl||'')")
  branch=$(json_get "$PACKAGES_FILE" "console.log(data.packages['$pkg']?.branch||'')")
  if [[ -z "$repo_url" ]]; then
    echo -e "${RED}✗ $pkg: 缺少 repoUrl${NC}"
    return 1
  fi
  mkdir -p "$GIT_DIR"
  if [[ ! -d "$GIT_DIR/$pkg/.git" ]]; then
    echo "  git clone $repo_url -> $GIT_DIR/$pkg"
    if [[ -n "$branch" ]]; then
      git clone --branch "$branch" "$repo_url" "$GIT_DIR/$pkg" 2>&1 | tail -2 || { echo -e "${RED}✗ $pkg clone 失败${NC}"; return 1; }
    else
      git clone "$repo_url" "$GIT_DIR/$pkg" 2>&1 | tail -2 || { echo -e "${RED}✗ $pkg clone 失败${NC}"; return 1; }
    fi
  else
    echo "  git pull + checkout $GIT_DIR/$pkg"
    git -C "$GIT_DIR/$pkg" fetch origin 2>&1 | tail -1 || true
    if [[ -n "$branch" ]]; then
      git -C "$GIT_DIR/$pkg" checkout "$branch" 2>&1 | tail -1 || true
    fi
    git -C "$GIT_DIR/$pkg" pull --ff-only 2>&1 | tail -1 || true
  fi
}

# status 命令
cmd_status() {
  echo -e "${BLUE}Pi 包状态${NC}\n"

  printf "%-40s %-12s %-12s %-10s %s\n" "包名" "已安装" "最新" "状态" "类型"
  printf "%-40s %-12s %-12s %-10s %s\n" "----" "------" "----" "----" "----"

  json_keys "$PACKAGES_FILE" | while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue

    local type target installed latest status color

    type=$(json_get "$PACKAGES_FILE" "console.log(data.packages['$pkg']?.type||'')")
    target=$(json_get "$PACKAGES_FILE" "console.log(data.packages['$pkg']?.installTarget||'')")

    installed=$(get_installed_version "$pkg" "$target")

    if [[ "${PI_CTL_SKIP_UPDATE_CHECK:-}" != "1" ]]; then
      if [[ "$target" == "git" ]]; then
        latest=$(get_git_latest "$pkg")
      else
        latest=$(get_latest_version "$pkg")
      fi
    else
      latest="-"
    fi

    if [[ "$installed" == "not installed" ]]; then
      status="missing"
      color="$RED"
    elif [[ "$installed" == "unknown" || "$latest" == "unknown" ]]; then
      status="unknown"
      color="$NC"
    elif [[ "$installed" == "$latest" ]]; then
      status="ok"
      color="$GREEN"
    else
      status="outdated"
      color="$YELLOW"
    fi

    printf "%-40s %-12s %-12s ${color}%-10s${NC} %s\n" "$pkg" "$installed" "$latest" "$status" "$type"
  done
}

# update 命令
cmd_update() {
  local pkg="${1:-}"

  if [[ -n "$pkg" ]]; then
    local target
    target=$(json_get "$PACKAGES_FILE" "console.log(data.packages['$pkg']?.installTarget||'')")

    if [[ -z "$target" ]]; then
      echo -e "${RED}错误: 包 '$pkg' 不在配置中${NC}"
      exit 1
    fi

    echo -e "${BLUE}更新 $pkg...${NC}"
    if [[ "$target" == "npm-global" ]]; then
      npm install -g "$pkg@latest"
    elif [[ "$target" == "git" ]]; then
      git_sync "$pkg"
    else
      cd "$BUNDLE_DIR" && npm install "$pkg@latest"
    fi
    echo -e "${GREEN}✓ $pkg 更新完成${NC}"
  else
    echo -e "${BLUE}更新所有包...${NC}"

    json_keys "$PACKAGES_FILE" | while IFS= read -r p; do
      [[ -z "$p" ]] && continue

      local target
      target=$(json_get "$PACKAGES_FILE" "console.log(data.packages['$p']?.installTarget||'')")

      echo -e "${BLUE}更新 $p...${NC}"
      if [[ "$target" == "npm-global" ]]; then
        npm install -g "$p@latest" 2>/dev/null && echo -e "${GREEN}✓${NC} $p" || echo -e "${RED}✗${NC} $p"
      elif [[ "$target" == "git" ]]; then
        git_sync "$p" && echo -e "${GREEN}✓${NC} $p" || echo -e "${RED}✗${NC} $p"
      else
        cd "$BUNDLE_DIR" && npm install "$p@latest" 2>/dev/null && echo -e "${GREEN}✓${NC} $p" || echo -e "${RED}✗${NC} $p"
      fi
    done
  fi
}

# install 命令
cmd_install() {
  echo -e "${BLUE}安装所有配置的包...${NC}"

  mkdir -p "$BUNDLE_DIR"
  if [[ ! -f "$BUNDLE_DIR/package.json" ]]; then
    cat > "$BUNDLE_DIR/package.json" << 'EOF'
{
  "name": "omi-toolkit",
  "version": "1.0.0",
  "private": true,
  "dependencies": {},
  "pi": {
    "extensions": []
  }
}
EOF
  fi

  json_keys "$PACKAGES_FILE" | while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue

    local target version
    target=$(json_get "$PACKAGES_FILE" "console.log(data.packages['$pkg']?.installTarget||'')")
    version=$(json_get "$PACKAGES_FILE" "console.log(data.packages['$pkg']?.version||'latest')")

    echo -e "${BLUE}安装 $pkg@$version...${NC}"
    if [[ "$target" == "npm-global" ]]; then
      npm install -g "$pkg@$version"
    elif [[ "$target" == "git" ]]; then
      git_sync "$pkg"
    else
      cd "$BUNDLE_DIR" && npm install "$pkg@$version"
    fi
  done

  # 同步 bundle 的 pi.extensions 列表
  node -e "
    const fs = require('fs');
    const cfg = JSON.parse(fs.readFileSync('$PACKAGES_FILE', 'utf8'));
    const bundlePath = '$BUNDLE_DIR/package.json';
    const bundle = JSON.parse(fs.readFileSync(bundlePath, 'utf8'));
    const paths = [];
    for (const [name, meta] of Object.entries(cfg.packages)) {
      if (meta.installTarget !== 'bundle') continue;
      if (Array.isArray(meta.extensionPaths)) paths.push(...meta.extensionPaths);
    }
    bundle.pi = bundle.pi || {};
    bundle.pi.extensions = paths;
    fs.writeFileSync(bundlePath, JSON.stringify(bundle, null, 2) + '\n');
    console.log('已同步 pi.extensions: ' + paths.length + ' 项');
  "

  echo -e "${GREEN}✓ 所有包安装完成${NC}"
}

# add 命令
cmd_add() {
  local pkg="$1"
  local version="${2:-latest}"
  local type="${3:-extension}"
  local target="${4:-bundle}"

  if [[ -z "$pkg" ]]; then
    echo -e "${RED}错误: 请指定包名${NC}"
    exit 1
  fi

  echo -e "${BLUE}添加 $pkg 到配置...${NC}"

  node -e "
    const fs = require('fs');
    const data = JSON.parse(fs.readFileSync('$PACKAGES_FILE', 'utf8'));
    data.packages['$pkg'] = {
      version: '$version',
      type: '$type',
      description: '',
      extensions: [],
      installTarget: '$target'
    };
    fs.writeFileSync('$PACKAGES_FILE', JSON.stringify(data, null, 2));
  "

  echo -e "${GREEN}✓ $pkg 已添加到配置${NC}"
  echo "提示: 编辑 $PACKAGES_FILE 添加描述和扩展列表"
}

# remove 命令
cmd_remove() {
  local pkg="$1"

  if [[ -z "$pkg" ]]; then
    echo -e "${RED}错误: 请指定包名${NC}"
    exit 1
  fi

  echo -e "${BLUE}从配置移除 $pkg...${NC}"

  local target
  target=$(json_get "$PACKAGES_FILE" "console.log(data.packages['$pkg']?.installTarget||'')")
  if [[ "$target" == "git" ]]; then
    rm -rf "$GIT_DIR/$pkg"
    echo "  已删除本地目录 $GIT_DIR/$pkg"
  fi
  node -e "
    const fs = require('fs');
    const data = JSON.parse(fs.readFileSync('$PACKAGES_FILE', 'utf8'));
    delete data.packages['$pkg'];
    fs.writeFileSync('$PACKAGES_FILE', JSON.stringify(data, null, 2));
  "

  echo -e "${GREEN}✓ $pkg 已从配置移除${NC}"
}

# list 命令
cmd_list() {
  echo -e "${BLUE}已配置的包:${NC}\n"
  node -e "
    const fs = require('fs');
    const data = JSON.parse(fs.readFileSync('$PACKAGES_FILE', 'utf8'));
    Object.entries(data.packages).forEach(([k, v]) => {
      console.log(k + ' (' + v.type + ') - ' + v.description);
    });
  "
}

# 主入口
case "${1:-}" in
  status)     cmd_status ;;
  update)     cmd_update "${2:-}" ;;
  install)    cmd_install ;;
  add)        cmd_add "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
  remove)     cmd_remove "${2:-}" ;;
  list)       cmd_list ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac