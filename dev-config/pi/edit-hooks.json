{
  "onStop": {
    "*.{ts,tsx}": "npx tsc --noEmit 2>&1",
    "*.json": "python3 -m json.tool '{file}' > /dev/null",
    "*.py": "python3 -m py_compile '{file}'",
    "*.sh": "bash -n '{file}'",
    "*.{yaml,yml}": "python3 -c \"import yaml,sys; yaml.safe_load(open(sys.argv[1]))\" '{file}'",
    "*.cs": "dotnet build --no-restore 2>&1 | tail -20"
  }
}
